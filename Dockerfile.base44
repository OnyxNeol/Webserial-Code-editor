FROM node:24-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ pkg-config \
    libsecret-1-dev libxkbfile-dev libkrb5-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Kept only as an optional native-build toolchain; development runs from
# bind-mounted source with lockfile installation defined in Compose.
WORKDIR /vscode
